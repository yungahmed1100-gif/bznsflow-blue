# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# MCP config holds an auth token — never commit
.mcp.json

# Secrets — never commit. Broad on purpose: `vercel env pull` writes real
# credentials to .env.local by default, and it is easy to name a dump
# .env.production or .env.bak and lose the protection of an exact-match rule.
# .env.example is the one file that must stay tracked.
.env
.env.*
!.env.example

# `vercel env pull` / credential dumps landing anywhere in the linked-project
# directory. .vercel/project.json itself is tracked and holds no secrets.
.vercel/*.txt
.vercel/.env*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Scratch: screenshots, baselines and working notes, not artefacts.
work/

# Working media. Large enough to ruin a clone if one is ever staged by accident;
# three at the repo root already came to 237 MB. Deliberately broad.
*.mp4
*.mov

.vercel
