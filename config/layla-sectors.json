    "catalog": {"sectors":["cakes","cafe","restaurant","retail"],"intents":["catalog_item","order_policy","delivery_info","availability_request"]},
    "project": {"sectors":["real-estate","construction","hvac","logistics","travel","events","marketing","technology","manufacturing","education"],"intents":["project_scope","coverage","quote_requirements","lead_qualification"]}
  },
  "rules": {"missing_fact":"fallback_to_human", "similarity_floor":0.72, "max_clarifications":1, "unsupported_action":"state_capability_and_offer_human"},
