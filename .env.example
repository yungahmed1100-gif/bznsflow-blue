# ==============================================================================
# BznsFlow — environment template.  Copy to .env and fill in:  cp .env.example .env
# This file is COMMITTED and must never contain real values.
#
# ⚠️  VITE_* vars are BAKED INTO THE PUBLIC BROWSER BUNDLE. Never give a secret
#     the VITE_ prefix — only public URLs belong there.
# ==============================================================================


# ─── DEPLOY / HOSTING ─────────────────────────────────────────────────────────
# No token belongs here. This project is NOT Git-connected on Vercel and deploys
# only through the logged-in CLI session — see README, Deployment. A VERCEL_TOKEN
# entry used to sit here; nothing in the repo ever read it.


# ─── AI / GENERATION ──────────────────────────────────────────────────────────
GEMINI_API_KEY=          # https://aistudio.google.com/apikey — agent avatar script


# ─── LAYLA CHAT BACKEND (Vercel /api/chat → OpenAI → Supabase) ────────────────
# Runbook: web-chatbot/SETUP.md · these are also set in Vercel (Prod + Preview).
#
# Leave VITE_CHAT_ENDPOINT UNSET — src/lib/chat.js defaults to same-origin
# '/api/chat'. Setting it is the rollback lever only.
# VITE_CHAT_ENDPOINT=

OPENAI_API_KEY=          # https://platform.openai.com/api-keys — powers Layla via /api/chat
OPENAI_MODEL=            # optional override; api/_lib/llm.js carries the default

SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # bypasses RLS — server-side only, never VITE_

CHAT_ALLOWED_ORIGINS=    # comma-separated; same-origin is always allowed
CHAT_RATE_IP_PER_MIN=    # default 20
CHAT_RATE_GLOBAL_PER_DAY=    # default 1000
CHAT_SMOKE_TOKEN=        # send as `message` for "pong" without a model call
CRON_SECRET=             # bearer token for the /api/keepalive cron (anti-pause)


# ─── LEAD PIPELINE (live — PlaybookModal and the sign-in page both post here) ─
VITE_LEAD_ENDPOINT=      # Apps Script /exec URL


# ─── SIGN-IN / EMAIL OTP (Vercel /api/auth-* → Supabase + Apps Script) ────────
# Schema + runbook: web-chatbot/migrations/003-accounts.sql
# Reuses SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above — same project.

LEAD_ENDPOINT=           # server-side copy of the Apps Script /exec URL (never VITE_)
OTP_SHARED_SECRET=       # Vercel → Apps Script auth; set the SAME value in the
                         # Apps Script project's Script Properties
AUTH_OTP_PEPPER=         # hashing pepper for stored OTP codes
AUTH_RATE_IP_PER_MIN=    # default 5 — code requests per IP per minute
AUTH_RATE_GLOBAL_PER_DAY=  # default 300 — sign-in requests per day, all visitors
LEAD_RATE_IP_PER_MIN=    # default 5 — playbook submissions per IP per minute

# ─── SOCIAL SIGN-IN (Vercel /api/auth-oauth → /api/auth-callback) ─────────────
# Schema + runbook: web-chatbot/migrations/004-oauth-identities.sql
# Registry + setup notes: api/_lib/oidc.js
#
# A provider whose pair is unset simply gets no button — GET /api/auth-session
# reports which are configured and the page renders only those. So it is safe to
# ship Google alone and add the others later.
#
# The redirect URI to register with EVERY provider is exactly:
#   https://www.bznsflowai.com/api/auth-callback
# plus http://localhost:3000/api/auth-callback for `npm run dev:api`.
# Google and Microsoft accept the localhost one; LinkedIn accepts neither
# localhost nor plain http, so LinkedIn can only be tested on a real domain.
# Wildcards are not allowed anywhere, so per-deploy preview URLs cannot be used.

GOOGLE_CLIENT_ID=        # Google Cloud Console → Credentials → OAuth client ID
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=            # Entra ID → App registrations → Overview
MS_CLIENT_SECRET=        # the secret VALUE, shown once; expires in ≤24 months
MS_TENANT=               # default `organizations` — work/school accounts only.
                         # Do NOT use `common` without the xms_edov optional
                         # claim: see the nOAuth note in api/_lib/oidc.js.
LINKEDIN_CLIENT_ID=      # needs a VERIFIED LinkedIn company page first
LINKEDIN_CLIENT_SECRET=

# ─── PUBLIC BUSINESS CONSTANTS ────────────────────────────────────────────────
# The booking link, WhatsApp link and contact address are NOT env vars: they are
# hardcoded in src/lib/constants.js, the single source of truth, and were listed
# here for a long time without anything reading them.
SITE_URL=https://www.bznsflowai.com


# ─── LAYLA — META CLOUD API (owner pilot and customer onboarding) ─────────────
# Engineering pack: docs/layla-meta-engineering.md
# vercel.json pins LAYLA_META_MODE, LAYLA_META_KILL_SWITCH, LAYLA_OPEN_TEST_ENABLED
# and LAYLA_CUSTOMER_ONBOARDING_ENABLED for Blue; scripts/check-blue-environment.mjs
# refuses the build if the live values reach Blue.

LAYLA_META_MODE=mock           # `mock` is the only value Blue accepts
LAYLA_META_KILL_SWITCH=true    # true blocks every outbound send
LAYLA_META_ACCESS_TOKEN=       # Green only — check-blue-environment rejects it in Blue
LAYLA_META_APP_ID=
LAYLA_META_APP_SECRET=         # also the webhook signature key
LAYLA_META_VERIFY_TOKEN=       # webhook hub.verify_token
LAYLA_META_WABA_ID=
LAYLA_META_PHONE_NUMBER_ID=
LAYLA_META_SENDER=             # digits only, no +
LAYLA_META_SENDER_NUMBER=
LAYLA_META_GRAPH_VERSION=      # default set in api/_lib/layla/config.js
LAYLA_META_WORKER_SECRET=      # bearer for /api/layla-meta-worker — Green only
LAYLA_OWNER_ACCOUNT_ID=        # the one account allowed to reach owner surfaces
LAYLA_CUSTOMER_ACCOUNT_IDS=    # comma-separated allowlist for customer surfaces
LAYLA_CUSTOMER_ONBOARDING_ENABLED=false
LAYLA_OPEN_TEST_ENABLED=false  # must stay false in Blue
LAYLA_EMBEDDED_SIGNUP_CONFIG_ID=


# Blue Convex backend (optional until the cloud deployment is provisioned).
# Only VITE_CONVEX_URL and VITE_CONVEX_SITE_URL may be public.
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Blue public review: server-only except VITE_CONVEX_URL. Never copy Green secrets.
CONVEX_CLOUD_URL=
BLUE_REVIEW_SERVICE_SECRET=
BLUE_REVIEW_VERIFY_TOKEN=
LAYLA_CREDENTIAL_ENCRYPTION_KEY=
LAYLA_CUSTOMER_CONFIG_ID=
# BLUE_CUSTOMER_SETUP_ENABLED controls new Meta setup, never enables sending.
BLUE_CUSTOMER_SETUP_ENABLED=false

# Blue-only account saving (Resend verified sender; server-side only)
BLUE_RESEND_API_KEY=
BLUE_AUTH_FROM=
BLUE_ACCOUNT_SAVE_ENABLED=false
BLUE_WEBSITE_IMPORT_ENABLED=false
BLUE_LIVE_MESSAGING_ENABLED=false
BLUE_MESSAGING_WORKER_SECRET=
# Owner dashboard (Chats, Contacts). Enable after `blueDashboard:migrationStatus` reports complete.
BLUE_DASHBOARD_ENABLED=false
# Broadcast sends approved marketing templates. Also requires the internal
# `blueCampaign:setBroadcastEnabled` gate and at least one approved template.
BLUE_BROADCAST_ENABLED=false
# Owner-approved move of ONE existing Cloud API number from other routing to Blue,
# as "<waba id>:<phone number id>". Only the existing_cloud path uses it. Empty = refuse.
BLUE_ROUTING_TAKEOVER=
# Embedded Signup flow for numbers already on an API: v3 (default) is business-first
# (portfolio -> WhatsApp account -> number); v4 is Meta's phone-number-first flow.
BLUE_SIGNUP_VERSION_EXISTING=
# Owner's own number (a WABA created directly in Meta cannot use Embedded Signup):
# "<owner email>:<waba id>:<phone id>:<business portfolio id>" plus a Blue-only system-user token. Remove the token after connecting.
BLUE_OWNER_CONNECT=
BLUE_OWNER_CONNECT_TOKEN=

# --- Local model, used only by the offline eval/authoring scripts -------------
# scripts/propose-eval-questions.mjs drafts candidate eval questions against a
# local Ollama server. Nothing under api/ reads these, nothing ships to Vercel,
# and no customer-facing path depends on them: the local model is an AUTHORING
# tool whose output a person reviews before it is committed.
# `npm run eval:intents` needs neither — it scores the committed labels offline.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=layla-ar

# --- Intent router kill switch ------------------------------------------------
# Set to 1 to make classify() fall straight back to the regexes in
# api/_lib/layla/guards.js, switching off the authored lexicon and the
# tenant-profile vocabulary layer in api/_lib/layla/route.js.
#
# Leave it UNSET. The router is non-regressive by construction — its layers are
# consulted only where the regexes already returned `unknown` — and it lifts the
# labelled set from 81.3% to 99.3% accuracy with the unknown fall-through down
# from 18.8% to 0.7%. This exists so a new thing can be turned off in a hurry
# without shipping code, not because it is expected to be needed.
BLUE_INTENT_ROUTER_DISABLED=

# Instagram Login (Blue only). OAuth app ID/secret come from Instagram >
# API setup with Instagram login > Business login settings, not the parent App ID.
BLUE_INSTAGRAM_ENABLED=false
BLUE_INSTAGRAM_APP_ID=
BLUE_INSTAGRAM_APP_SECRET=
BLUE_INSTAGRAM_GRAPH_VERSION=v25.0
# Callback signature secret for the app owning the Instagram webhook subscription.
# Defaults to LAYLA_META_APP_SECRET for this parent-app subscription.
# Override for a different subscription owner; verify against a real signed event.
BLUE_INSTAGRAM_WEBHOOK_SECRET=
BLUE_INSTAGRAM_VERIFY_TOKEN=
# Sending stays off until a controlled, explicitly authorized rehearsal.
BLUE_INSTAGRAM_SEND_ENABLED=false
# Comma-separated customer Instagram-scoped IDs; empty blocks every send.
# Use * only after approval and a successful customer-account rehearsal.
BLUE_INSTAGRAM_TEST_SENDERS=
